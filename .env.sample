# --- Postgres (experiment tracking database) ---
POSTGRES_USER='your_postgres_user'
POSTGRES_PASSWORD='your_postgres_password'
POSTGRES_MAPPED_PORT=5432
POSTGRES_HOST='localhost'
POSTGRES_DB='your_postgres_db'

# --- Adminer (optional Postgres web UI, see docker-compose.yaml) ---
ADMINER_MAPPED_PORT=8080

# --- Experiment settings ---
EXECUTION_PROFILE = 'Panther'
RANDOM_SEEDS='47382, 91056, 23719'

# --- White Noise settings ---
WHITE_NOISE = [40, 30, 20, 10, 5, 0, -5, -1, -20]

# --- Spikes settings ---
SPIKES_AMP = [3, 5, 10]
SPIKES_RATE = [0.01, 0.05, 0.1, 0.2]

# --- Stuck settings ---
STUCK_RATE = [0.01, 0.05, 0.1, 0.2]
STUCK_BLOCKS = [1, 3, 5, 10, 20]

# --- Point swap ---
POINT_SWAP_RATE = [0.01, 0.05, 0.1, 0.2, 0.3, 0.4]

# --- Segment swap ---
SEGMENT_SWAP_RATE = [0.01, 0.05, 0.1, 0.2, 0.3]
SEGMENT_SWAP_NUM_SWAPS = [1, 3, 5, 10, 20]

# --- Permutation swap ---
PERMUTATION_NUM = [2, 4, 8, 16, 24]

# --- Missing (Point) ---
MISSING_POINT_RATE = [0.01, 0.05, 0.1, 0.2]
MISSING_POINT_MECH = ['MCAR', 'MNAR_high', 'MNAR_extreme']

# --- Missing (Burst) ---
MISSING_BURST_RATE = [0.01, 0.05, 0.1, 0.2]
MISSING_BURST_NUM = [1, 3, 5, 10]

# --- Missing Gilbert Elliot ---
MISSING_GE_A = [0.01, 0.05, 0.1]
MISSING_GE_B = [0.1, 0.25, 0.5]
