# Thesis Timeseries Gitignore

# Ignore Python cache files
__pycache__/
*.pyc
.ipynb_checkpoints/

# Ignore heavy regenerable outputs (corruptions, metrics, plots)
# Exception: robust_subset_TSB.csv is the 141-series subset definition
# (reproducibility input, needed by experiments)
outputs/*
results/*
!results/tables/
results/tables/*
!results/tables/robust_subset_TSB.csv

# Ignore raw data to prevent giant commits
data/raw/*
TSB-UAD/data/*
!TSB-UAD/data/.keep

# Ignore downloaded datasets at project root
/data/

# Exceptions: we might want to keep the subset lists
!data/subsets/*

# Environment variables
.env

# Postgres data directory (bind-mounted, contains local DB state)
postgres/data/

# OS specific
.DS_Store
Thumbs.db

# Python virtual environment
venv/
.venv/

# Thesis drafts (Word / PDF) — kept local, not pushed
*.docx
*.pdf

# Editor / tooling
.vscode/
.claude/

# Temp / scratch dirs
.tmp.driveupload/
.tmp_*/
tmp*/
soffice_convert_*/
soffice_profile_*/

# Generated document-render output (PDF/image render checks)
render_check_*/
rendered_*/

# Compiled binaries
*.exe

# Vendored clone of TSB-AD (own upstream repo + ~358MB of datasets).
# Local modifications are preserved as patches in vendor_patches/tsb_ad/.
TSB-AD/

# Bulk project directories kept local only
/figures/
/notebooks/
/src/
/TSB-UAD/
/vendor_patches/

# Evaluation output dirs (regenerable from src/experiments/)
eval_350/
eval_350_benchmark/
eval_350_raw/
eval_subset_350/
eval_subset_easy/
eval_subset_hard/
eval_subset_medium/
eval_thre_50/
src/results/

# Scratch / one-off debugging scripts
/test.py
/tt.py
/scores.py
/debug_tsb.py
/scratch_avg.py
/p.ipynb
/exhaustive_test.py
/investigate_perfect.py
/prove_vus_bug.py
/old_basic_metrics.py
/old_basic_metricor.py
/new_basic_metrics.py
