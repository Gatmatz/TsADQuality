# Thesis Timeseries Gitignore

# Ignore Python cache files
__pycache__/
*.pyc
.ipynb_checkpoints/

# Ignore heavy regenerable outputs (corruptions, metrics, plots)
# Exception: robust_subset_TSB.csv is the 141-series subset definition
# (reproducibility input, needed by experiments)
outputs/*
results/*
!results/tables/
results/tables/*
!results/tables/robust_subset_TSB.csv

# Ignore raw data to prevent giant commits
data/raw/*
TSB-UAD/data/*
!TSB-UAD/data/.keep

# Exceptions: we might want to keep the subset lists
!data/subsets/*

# OS specific
.DS_Store
Thumbs.db

# Python virtual environment
venv/
.venv/

# Thesis drafts (Word / PDF) — kept local, not pushed
*.docx
*.pdf

# Vendored copy of Time-Series-Library (has its own upstream repo)
Time-Series-Library/

# Editor / tooling
.vscode/
.claude/

# Temp / scratch dirs
.tmp.driveupload/
.tmp_*/
tmp*/
soffice_convert_*/
soffice_profile_*/

# Generated document-render output (PDF/image render checks)
render_check_*/
rendered_*/

# Compiled binaries
*.exe
